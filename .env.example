# DeFiLlama — free, no key needed
# https://api-docs.defillama.com

# Alchemy — prices API
ALCHEMY_API_KEY=your_alchemy_key

# The Graph — subgraph queries
THEGRAPH_API_KEY=your_thegraph_key

# Dune Analytics — protocol revenue
DUNE_API_KEY=your_dune_key

# Zapper — token prices
ZAPPER_API_KEY=your_zapper_key

# Reown AppKit — wallet connect modal
# Get at https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id

# 1inch Fusion+ — swap quotes & referral fee
# Get the API key at https://portal.1inch.dev (kept server-side via the Worker)
NEXT_PUBLIC_1INCH_API_KEY=your_1inch_key
NEXT_PUBLIC_INVESTFI_FEE_RECEIVER=0xYourWalletAddress
NEXT_PUBLIC_1INCH_FEE_BPS=50

# 1inch proxy (Cloudflare Worker — see worker/README.md)
# Without this, the browser cannot call api.1inch.dev (CORS blocked)
NEXT_PUBLIC_1INCH_PROXY_URL=https://investfi-1inch-proxy.example.workers.dev
